    {"/heltec/display", "", "mode", 0, 3},
    {"/heltec/bluetooth", "", "enabled", 0, 1},
    {"/heltec/bluetooth", "", "mode", 0, 2},
    {"/heltec/bluetooth", "", "pin", 0, 999999},
    {"/heltec/module", "mqtt", "enabled", 0, 1},
    {"/heltec/module", "mqtt", "encryption", 0, 1},
