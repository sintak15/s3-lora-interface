    {"/heltec/module", "paxcounter", "wifi", -127, 0},
    {"/heltec/module", "paxcounter", "ble", -127, 0},
  };
  const String route = server.uri();
  const String section = server.arg("section");
  for (const auto& rule : rules) {
    if (route != rule.route || (rule.section[0] && section != rule.section) || !server.hasArg(rule.name)) continue;
    int64_t parsed;
    if (!Reliability::parseInteger(server.arg(rule.name).c_str(), rule.minimum, rule.maximum, parsed) ||
        (route == "/heltec/module" && section == "canned_message" &&
         (strcmp(rule.name, "cw") == 0 || strcmp(rule.name, "ccw") == 0 || strcmp(rule.name, "press") == 0) &&
         parsed != 0 && parsed != 10 && parsed != 17 && parsed != 18 && parsed != 19 && parsed != 20 && parsed != 24 && parsed != 27)) {
      server.send(400, "text/plain", String("invalid numeric setting: ") + rule.name);
      return false;
    }
  }
  return true;
}
